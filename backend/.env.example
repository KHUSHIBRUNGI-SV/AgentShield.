# Copy to backend/.env and configure values for your own environment.
# Never commit backend/.env or use placeholder values as credentials.
AGENTSHIELD_ENVIRONMENT=development
# Local Windows development: sqlite-dev creates backend/data/agentshield-dev.sqlite3.
# For PostgreSQL set AGENTSHIELD_DATABASE_MODE=postgres and configure DATABASE_URL.
AGENTSHIELD_DATABASE_MODE=sqlite-dev
AGENTSHIELD_SECRET_KEY=
AGENTSHIELD_JWT_ISSUER=agentshield
AGENTSHIELD_JWT_AUDIENCE=agentshield-api
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
AGENTSHIELD_REVIEWER_USERNAME=
AGENTSHIELD_REVIEWER_PASSWORD=
AGENTSHIELD_AGENT_USERNAME=
AGENTSHIELD_AGENT_PASSWORD=
AGENTSHIELD_SANDBOX_TOKEN=
AGENTSHIELD_SANDBOX_URL=
# Explicit local dashboard origins. Development also defaults to these two
# origins if this variable is omitted; production requires an explicit list.
AGENTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
