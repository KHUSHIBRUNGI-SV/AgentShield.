AGENTSHIELD_AGENT_PASSWORD=
AGENTSHIELD_SANDBOX_TOKEN=changeme
AGENTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
POSTGRES_DB=agentshield
POSTGRES_USER=agentshield
